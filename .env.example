# JARVIS Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# WhatsApp Integration (web | mock)
WHATSAPP_ADAPTER=web
WHATSAPP_SESSION_PATH=./data/whatsapp-session
WHATSAPP_HEADLESS=true

# Database Path
DATABASE_PATH=./data/jarvis.db

# Automation & Timer Defaults
AUTOMATION_MASTER_SWITCH=true
DEFAULT_RESPONSE_DELAY_SECONDS=180
MAX_RESPONSE_DELAY_SECONDS=3600
WAKE_PHRASES="Hey Jarvis,Hi Jarvis,Hello Jarvis,Jarvis,OK Jarvis,Okay Jarvis,Ji Jarvis"

# AI Provider Configuration (mock | groq | gemini | lmstudio | ollama | disabled)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
AI_TIMEOUT_MS=15000

# Voice / Audio Transcription (Optional)
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
ENABLE_VOICE_RESPONSES=false

